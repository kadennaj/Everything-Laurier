{
  "name": "everything-laurier",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.2",
    "decode-uri-component": "file:vendor/decode-uri-component",
    "expo": "~57.0.30",
    "expo-asset": "~57.0.20",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "braces": "file:vendor/braces",
    "node-forge": "file:vendor/node-forge"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "export:web": "expo export --platform web",
    "dev": "expo start --web --localhost --port 8081",
    "test:auth": "node --experimental-strip-types --test tests/auth-flow.test.mjs",
    "check:release-privacy": "node scripts/check-release-privacy.mjs",
    "eas-build-post-install": "node scripts/check-eas-release.mjs",
    "build:map": "node scripts/build-map.mjs",
    "build:privacy": "node scripts/build-privacy.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "private": true,
  "overrides": {
    "braces": "$braces",
    "node-forge": "$node-forge",
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
