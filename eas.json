{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://everythinglaurier.ca/privacy/"
      },
      "environment": "production"
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://everythinglaurier.ca/privacy/"
      },
      "autoIncrement": true
    },
    "preview": {
      "distribution": "internal",
      "environment": "production",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://everythinglaurier.ca/privacy/"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "everythinglaurier@gmail.com",
        "ascAppId": "6830356811",
        "appleTeamId": "JRCUQ9JQW6"
      }
    }
  }
}
