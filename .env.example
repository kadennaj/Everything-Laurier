# Optional overrides for the app's built-in public Supabase configuration.
# Never use a service_role key, secret key, or database password here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set false to temporarily disable sign-in on this computer.
EXPO_PUBLIC_EMAIL_LOGIN_ENABLED=true
# Public HTTPS privacy-policy page. Required for production builds.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://everythinglaurier.ca/privacy/
